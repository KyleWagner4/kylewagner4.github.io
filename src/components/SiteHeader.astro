---
/*
  Site masthead: name, section links and the theme control, on the grid.
  The section links point at the home page, so they work from any page.
  Below desktop they drop out; the home page is short and reads top to
  bottom.
*/
import Cell from './Cell.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container grid">
    <Cell span={6} lg={{ span: 3 }} class="name">
      <a href="/" class="t-label">Kyle Wagner</a>
    </Cell>
    <Cell as="nav" aria-label="Site" lg={{ start: 4, span: 6 }} class="nav">
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="t-data">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </Cell>
    <Cell span={6} lg={{ start: 10, span: 3 }} class="tools">
      <ThemeToggle />
    </Cell>
  </div>
</header>

<style>
  .site-header {
    padding-block: var(--space-6);
  }

  .site-header .grid {
    align-items: center;
  }

  .name a {
    color: var(--ink);
    text-decoration: none;
  }

  .nav {
    display: none;
  }

  .nav ul {
    display: flex;
    gap: var(--space-8);
  }

  .nav a {
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .name a:hover,
  .nav a:hover {
    color: var(--accent);
  }

  .tools {
    display: flex;
    justify-content: end;
  }

  @media (min-width: 64rem) {
    .nav {
      display: block;
    }
  }
</style>
