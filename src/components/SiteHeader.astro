---
/*
  Site masthead: name, section links and the theme control, on the grid.
  The section links point at the home page, so they work from any page.
  From 48rem they sit beside the name; on phones they take a second row
  under the name and theme control, starting on column 1.
*/
import Cell from './Cell.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container grid">
    <Cell span={6} md={{ span: 3 }} class="name">
      <a href="/" class="t-label">Kyle Wagner</a>
    </Cell>
    <Cell as="nav" aria-label="Site" md={{ start: 4, span: 6 }} class="nav">
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="t-data">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </Cell>
    <Cell span={6} md={{ start: 10, span: 3 }} class="tools">
      <ThemeToggle />
    </Cell>
  </div>
</header>

<style>
  .site-header {
    padding-block: var(--space-6);
  }

  .site-header .grid {
    align-items: center;
  }

  .name a {
    color: var(--ink);
    text-decoration: none;
  }

  /* An explicit row, so the name and theme control still pair up on
     the first one. */
  .nav {
    grid-row: 2;
    margin-block-start: var(--space-3);
  }

  .nav ul {
    display: flex;
    gap: var(--space-6);
  }

  /* Padding gives each link a taller target without loosening the row. */
  .nav a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  @media (min-width: 48rem) {
    .nav {
      grid-row: auto;
      margin-block-start: 0;
    }

    .nav ul {
      gap: var(--space-8);
    }
  }

  .name a:hover,
  .nav a:hover {
    color: var(--accent);
  }

  .tools {
    display: flex;
    justify-content: end;
  }
</style>
